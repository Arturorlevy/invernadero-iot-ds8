# Copie este archivo como .env y complete sus datos. .env NO se sube a GitHub.

# Broker MQTT del dispositivo (debe coincidir con dispositivo/config.py)
MQTT_BROKER=broker.hivemq.com
MQTT_PORT=1883
TOPICO_RAIZ=ds8/invernadero
DISPOSITIVO_ID=inv-ds8-zcmr

# Base de datos SQLite
DB_PATH=data/invernadero.db

# Adafruit IO (https://io.adafruit.com -> icono de llave "My Key")
AIO_USERNAME=
AIO_KEY=
AIO_PREFIJO=inv
AIO_INTERVALO_S=20

LOG_LEVEL=INFO
